{
  "sourceLanguage": "fr",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly utilise la caméra pour identifier la race de votre chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly uses the camera to identify your cat's breed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly verwendet die Kamera, um die Rasse deiner Katze zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly usa la cámara para identificar la raza de tu gato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly usa la fotocamera per identificare la razza del tuo gatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrlyはカメラを使って猫の品種を識別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly는 카메라로 고양이의 품종을 식별합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Purrly usa a câmera para identificar a raça do seu gato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly 使用相机来识别您猫咪的品种。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly accède à vos photos pour analyser la race de votre chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly accesses your photos to analyze your cat's breed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly greift auf deine Fotos zu, um die Rasse deiner Katze zu analysieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly accede a tus fotos para analizar la raza de tu gato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly accede alle tue foto per analizzare la razza del tuo gatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrlyは猫の品種を分析するために写真にアクセスします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly는 고양이의 품종을 분석하기 위해 사진에 접근합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Purrly acessa suas fotos para analisar a raça do seu gato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly 访问您的照片以分析猫咪的品种。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly utilise votre position pour trouver des vétérinaires et éleveurs à proximité."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly uses your location to find nearby veterinarians and breeders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly verwendet deinen Standort, um Tierärzte und Züchter in der Nähe zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly usa tu ubicación para encontrar veterinarios y criadores cercanos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly usa la tua posizione per trovare veterinari e allevatori nelle vicinanze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrlyは近くの獣医やブリーダーを探すために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly는 근처의 수의사와 브리더를 찾기 위해 위치를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Purrly usa sua localização para encontrar veterinários e criadores próximos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly 使用您的位置来查找附近的兽医和繁育者。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly sauvegarde vos photos Photo Booth dans votre galerie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly saves your Photo Booth photos to your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly speichert deine Photo-Booth-Fotos in deiner Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly guarda tus fotos del Photo Booth en tu galería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly salva le tue foto Photo Booth nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PurrlyはPhoto Boothの写真をライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly는 Photo Booth 사진을 라이브러리에 저장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Purrly salva suas fotos do Photo Booth na sua galeria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Purrly 将您的 Photo Booth 照片保存到相册。"
          }
        }
      }
    }
  }
}