// Copier vers Secrets.xcconfig (non versionné) et remplir les valeurs.
// Ne jamais committer Secrets.xcconfig.

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key
RORK_API_BASE_URL = http:/$()/localhost:3000
VIP_EMAILS = admin@purrly.app,vip@purrly.app
DEMO_EMAIL = demo@purrly.app
// Clé SDK publique iOS RevenueCat (préfixe appl_). Tableau de bord RevenueCat → Project → API keys.
REVENUECAT_IOS_API_KEY = appl_your_ios_public_sdk_key
