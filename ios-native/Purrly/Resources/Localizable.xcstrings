    "%@ a été bloqué·e. Son contenu n'apparaît plus dans votre fil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde blockiert. Die Inhalte erscheinen nicht mehr in deinem Feed."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been blocked. Their content no longer appears in your feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha sido bloqueado. Su contenido ya no aparece en tu feed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato bloccato. I suoi contenuti non compaiono più nel tuo feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんをブロックしました。今後、その投稿はフィードに表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 차단했습니다. 이제 해당 사용자의 콘텐츠가 피드에 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi bloqueado. O conteúdo dessa pessoa não aparece mais no seu feed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽%@，其内容将不再出现在你的动态中。"
          }
        }
      }
    },
