    "Merci. Ce contenu a été masqué et signalé à notre équipe, qui agira sous 24 h.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Dieser Inhalt wurde ausgeblendet und unserem Team gemeldet, das innerhalb von 24 Stunden reagiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. This content has been hidden and reported to our team, which will act within 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Este contenido se ha ocultado y se ha notificado a nuestro equipo, que actuará en un plazo de 24 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Questo contenuto è stato nascosto e segnalato al nostro team, che interverrà entro 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。このコンテンツは非表示にし、運営チームに報告しました。24時間以内に対応いたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 이 콘텐츠는 숨김 처리되었으며 24시간 이내에 조치할 담당 팀에 신고되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Este conteúdo foi ocultado e denunciado à nossa equipe, que agirá em até 24 h."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。该内容已被隐藏并上报给我们的团队，团队将在 24 小时内处理。"
          }
        }
      }
    },
