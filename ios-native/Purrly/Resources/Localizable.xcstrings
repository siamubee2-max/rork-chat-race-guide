    "cats.empty.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre Katzen hinzu, um Rasse, Chip und Gesundheitsakte zu verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your cats to track breed, chip, and health records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega tus gatos para rastrear raza, chip y registros de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos chats pour suivre race, puce et carnet de santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi gatti per monitorare razza, microchip e salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫を追加して品種、マイクロチップ、健康記録を管理しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이를 추가하여 품종, 칩, 건강 기록을 추적하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seus gatos para acompanhar raça, chip e registros de saúde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的猫咪以追踪品种、芯片和健康记录。"
          }
        }
      }
    },
