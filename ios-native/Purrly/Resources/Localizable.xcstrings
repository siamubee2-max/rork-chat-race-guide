    "Tolérance zéro pour les contenus offensants, haineux ou illégaux, et pour les comportements abusifs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Null Toleranz für anstößige, hasserfüllte oder illegale Inhalte sowie für missbräuchliches Verhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero tolerance for offensive, hateful or illegal content, and for abusive behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cero tolerancia con el contenido ofensivo, de odio o ilegal, y con los comportamientos abusivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolleranza zero per contenuti offensivi, di odio o illegali e per i comportamenti abusivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不適切、差別的、または違法なコンテンツ、および迷惑行為は一切許容しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불쾌감을 주거나 혐오적이거나 불법적인 콘텐츠, 그리고 악의적인 행위에 대해 무관용 원칙을 적용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolerância zero com conteúdos ofensivos, de ódio ou ilegais, e com comportamentos abusivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对不良、仇恨或违法内容以及辱骂行为零容忍。"
          }
        }
      }
    },
