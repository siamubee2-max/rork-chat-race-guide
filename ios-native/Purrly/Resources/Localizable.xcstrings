    "80% des chats ont des problèmes dentaires à 3 ans. Brossage ou friandises dentaires recommandés.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "80 % der Katzen haben mit 3 Jahren Zahnprobleme. Zähneputzen oder Dental-Snacks werden empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "80% of cats have dental issues by age 3. Brushing or dental treats are recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 80% de los gatos tiene problemas dentales a los 3 años. Se recomienda cepillado o premios dentales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "80% des chats ont des problèmes dentaires à 3 ans. Brossage ou friandises dentaires recommandés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'80% dei gatti ha problemi dentali entro i 3 anni. Consigliati spazzolatura o snack dentali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫の80%は3歳までに歯のトラブルを抱えます。歯磨きやデンタルおやつがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이의 80%는 3살까지 치아 문제가 생깁니다. 양치질이나 덴탈 간식을 권장해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "80% dos gatos têm problemas dentários aos 3 anos. Escovação ou petiscos dentais são recomendados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "80%的猫在3岁前会出现牙齿问题。建议刷牙或使用洁齿零食。"
          }
        }
      }
    },
