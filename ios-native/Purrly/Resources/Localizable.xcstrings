    "Pesez votre chat tous les mois. Une variation de 10% mérite une consultation vétérinaire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiegen Sie Ihre Katze jeden Monat. Eine Veränderung von 10 % sollte tierärztlich abgeklärt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigh your cat every month. A 10% change warrants a vet visit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesa a tu gato cada mes. Una variación del 10% merece una visita al veterinario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesez votre chat tous les mois. Une variation de 10% mérite une consultation vétérinaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesa il tuo gatto ogni mese. Una variazione del 10% merita una visita veterinaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月体重を測りましょう。10%の変動があれば獣医に相談を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매달 체중을 재 주세요. 10% 변화가 있다면 수의사 상담이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese seu gato todo mês. Uma variação de 10% merece uma consulta veterinária."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月给猫称重。体重变化达10%时应咨询兽医。"
          }
        }
      }
    },
