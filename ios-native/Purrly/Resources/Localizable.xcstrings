    "Enregistrez régulièrement le poids pour détecter des variations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse das Gewicht regelmäßig, um Veränderungen zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record weight regularly to detect variations."
          }
        },
        "es": {
