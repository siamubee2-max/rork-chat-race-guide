    "• Messages envoyés à l'assistant IA (traités en temps réel, non conservés)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• An den KI-Assistenten gesendete Nachrichten (in Echtzeit verarbeitet, nicht gespeichert)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Messages sent to AI assistant (processed in real time, not stored)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Mensajes enviados al asistente IA (procesados en tiempo real, no almacenados)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Messaggi inviati all'assistente IA (elaborati in tempo reale, non conservati)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• AIアシスタントへのメッセージ（リアルタイム処理、保存なし）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• AI 어시스턴트에게 보낸 메시지 (실시간 처리, 저장 안 함)"
          }
        },
        "pt-BR": {
