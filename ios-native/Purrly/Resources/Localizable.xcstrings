    "Votre chat en un coup d'œil — prochain rappel et scan rapide.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Katze auf einen Blick — nächste Erinnerung und Schnellscan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cat at a glance — next reminder and quick scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gato de un vistazo: próximo recordatorio y escaneo rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre chat en un coup d'œil — prochain rappel et scan rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo gatto a colpo d'occhio: prossimo promemoria e scansione rapida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの猫をひと目で — 次のリマインダーとクイックスキャン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 고양이를 한눈에 — 다음 알림과 빠른 스캔."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu gato num relance — próximo lembrete e escaneamento rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼掌握你的猫 — 下个提醒和快速扫描。"
          }
        }
      }
    },
