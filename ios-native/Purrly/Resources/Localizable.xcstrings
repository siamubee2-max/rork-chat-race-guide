    "assistant.offline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann den Server momentan nicht erreichen. Überprüfen Sie Ihre Verbindung und die API-Konfiguration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot reach the server right now. Check your connection and API configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo conectarme al servidor ahora. Verifica tu conexión y la configuración de la API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas joindre le serveur pour le moment. Vérifiez votre connexion et la configuration API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riesco a raggiungere il server al momento. Controlla la connessione e la configurazione API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在サーバーに接続できません。接続とAPI設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 서버에 연결할 수 없습니다. 연결 및 API 구성을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consigo acessar o servidor agora. Verifique sua conexão e configuração da API."
