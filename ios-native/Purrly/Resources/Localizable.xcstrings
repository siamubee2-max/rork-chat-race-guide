    "Avant de continuer, merci d'accepter nos règles. Elles protègent tous les membres.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du fortfährst, akzeptiere bitte unsere Regeln. Sie schützen alle Mitglieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before continuing, please accept our rules. They protect all members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de continuar, acepta nuestras normas. Protegen a todos los miembros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di continuare, accetta le nostre regole. Proteggono tutti i membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける前に、コミュニティのルールに同意してください。ルールはすべてのメンバーを守るためのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 커뮤니티 규칙에 동의해 주세요. 이 규칙은 모든 회원을 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de continuar, aceite nossas regras. Elas protegem todos os membros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在继续之前，请接受我们的规则。它们保护每一位成员。"
          }
        }
      }
    },
