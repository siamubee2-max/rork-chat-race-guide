    "Il griffe les canapés… je suis à bout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zerkratzt die Sofas… ich bin mit den Nerven am Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He scratches the sofas… I'm at my wit's end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Araña los sofás… ya no puedo más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Graffia i divani… sono allo stremo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うちの子がソファで爪とぎばかりして…もう限界です。"
