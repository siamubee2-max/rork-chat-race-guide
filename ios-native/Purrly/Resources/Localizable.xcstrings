    "15–20 min de jeu quotidien réduit le stress et prévient l'obésité.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 Minuten tägliches Spielen reduziert Stress und beugt Übergewicht vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 minutes of daily play reduces stress and prevents obesity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 minutos de juego diario reducen el estrés y previenen la obesidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 min de jeu quotidien réduit le stress et prévient l'obésité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 minuti di gioco al giorno riducono lo stress e prevengono l'obesità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日15〜20分の遊びでストレスが減り、肥満予防にもなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 15~20분 놀이로 스트레스를 줄이고 비만을 예방할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "15–20 minutos de brincadeira por dia reduzem o estresse e previnem a obesidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天玩耍15–20分钟可减轻压力并预防肥胖。"
          }
        }
      }
    },
