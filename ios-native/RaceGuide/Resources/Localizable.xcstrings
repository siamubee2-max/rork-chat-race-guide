    "• Email et nom d'utilisateur (pour la création de compte)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Email and username (for account creation)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Correo y nombre de usuario (para crear cuenta)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• E-Mail und Benutzername (zur Kontoerstellung)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Email e nome utente (per la creazione dell'account)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• メールアドレスとユーザー名（アカウント作成用）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• E-mail e nome de usuário (para criação de conta)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• 이메일과 사용자 이름 (계정 생성용)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 电子邮件和用户名（用于账户创建）"
          }
        }
      }
    },
    "• Messages envoyés à l'assistant IA (traités en temps réel, non conservés)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Messages sent to AI assistant (processed in real time, not stored)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Mensajes enviados al asistente IA (procesados en tiempo real, no almacenados)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• An den KI-Assistenten gesendete Nachrichten (in Echtzeit verarbeitet, nicht gespeichert)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Messaggi inviati all'assistente IA (elaborati in tempo reale, non conservati)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• AIアシスタントへのメッセージ（リアルタイム処理、保存なし）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Mensagens enviadas ao assistente IA (processadas em tempo real, não armazenadas)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• AI 어시스턴트에게 보낸 메시지 (실시간 처리, 저장 안 함)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 发送给AI助手的消息（实时处理，不保存）"
          }
        }
      }
    },
    "• Photos de chats (transmises temporairement pour l'analyse de races, non conservées)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Cat photos (temporarily sent for breed analysis, not stored)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Fotos de gatos (enviadas temporalmente para análisis de raza, no almacenadas)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Katzenfotos (temporär für Rassenanalyse übertragen, nicht gespeichert)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Foto di gatti (trasmesse temporaneamente per l'analisi della razza, non conservate)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 猫の写真（品種分析のために一時的に送信、保存なし）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Fotos de gatos (enviadas temporariamente para análise de raça, não armazenadas)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• 고양이 사진 (품종 분석을 위해 임시 전송, 저장 안 함)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 猫咪照片（临时发送用于品种分析，不保存）"
          }
        }
      }
    },
