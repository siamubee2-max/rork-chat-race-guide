#!/usr/bin/env bash
# Secret-scanning pre-commit guard (zero-dependency).
# Prefers gitleaks if installed; otherwise falls back to a self-contained
# regex scan of staged content. Blocks the commit on any match.
#
# Activated repo-wide via: git config core.hooksPath scripts/git-hooks
# Bypass (only if you are SURE): git commit --no-verify
set -euo pipefail

# 1) Prefer gitleaks if available — most thorough.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner; then
    echo "✖ gitleaks blocked this commit: staged changes contain a secret." >&2
    echo "  Remove it, or bypass with --no-verify only if it is a false positive." >&2
    exit 1
  fi
  exit 0
fi

# 2) Fallback: self-contained regex scan of staged additions.
staged="$(git diff --cached --no-color -U0 | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
[ -z "$staged" ] && exit 0

# Patterns: provider keys + assigned auth-token style values.
# PLACEHOLDER_TOKEN below is intentionally ignored so docs/skeletons pass.
patterns=(
  'sk-or-v1-[A-Za-z0-9]{20,}'          # OpenRouter
  'sk-(proj-)?[A-Za-z0-9]{20,}'        # OpenAI
  'AKIA[0-9A-Z]{16}'                   # AWS access key id
  'AIza[0-9A-Za-z_\-]{30,}'            # Google API key
  'ghp_[A-Za-z0-9]{30,}'               # GitHub PAT
  'xox[baprs]-[A-Za-z0-9-]{10,}'       # Slack
  '-----BEGIN [A-Z ]*PRIVATE KEY-----' # private keys
  '"ANTHROPIC_AUTH_TOKEN"[[:space:]]*:[[:space:]]*"[^"]{12,}"' # populated auth token
)

hit=0
for p in "${patterns[@]}"; do
  m="$(printf '%s\n' "$staged" | grep -nE -e "$p" | grep -vi 'PLACEHOLDER' || true)"
  if [ -n "$m" ]; then
    if [ "$hit" -eq 0 ]; then
      echo "✖ pre-commit: possible secret in staged changes." >&2
      hit=1
    fi
    echo "  pattern: $p" >&2
    printf '%s\n' "$m" | sed 's/^/    /' >&2
  fi
done

if [ "$hit" -ne 0 ]; then
  echo "" >&2
  echo "  Move secrets to .claude/settings.local.json (gitignored) or env vars." >&2
  echo "  If this is a false positive: git commit --no-verify" >&2
  exit 1
fi
exit 0
