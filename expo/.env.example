# ============================================================
# Purrly — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE PAS COMMITTER le fichier .env (déjà dans .gitignore)
# ============================================================

# ============================================================
# RevenueCat — Clés API publiques
# Récupérer depuis : https://app.revenuecat.com/projects/PROJECT_ID/api-keys
# ============================================================
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_api_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_api_key
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_test_api_key

# ============================================================
# tRPC / Backend API
# En dev : http://localhost:3000
# En prod : URL de votre serveur déployé (ex: https://api.purrly.app)
# ============================================================
EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:3000

# ============================================================
# Supabase — Base de données cloud
# Récupérer depuis : https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ============================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key — backend ONLY, ne jamais exposer côté client
# Récupérer depuis : Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# Comptes VIP (accès Pro à vie) — jamais hardcoder dans le code
# Format : emails séparés par des virgules
# ============================================================
EXPO_PUBLIC_VIP_EMAILS=admin@purrly.app,vip@purrly.app

# ============================================================
# Compte de démonstration pour l'App Review Apple & Google
# Ce compte doit exister dans Supabase Auth avec le plan Premium
# Login : demo@purrly.app / Demo1234!
# ============================================================
EXPO_PUBLIC_DEMO_EMAIL=demo@purrly.app
EXPO_PUBLIC_DEMO_PASSWORD=Demo1234!

# ============================================================
# OpenAI — backend ONLY
# ⚠️  Ne jamais préfixer avec EXPO_PUBLIC_ (serait exposé dans le bundle)
# Récupérer depuis : https://platform.openai.com/api-keys
# Utilisé par le backend tRPC pour les appels IA server-side
# ============================================================
OPENAI_API_KEY=sk-proj-your_openai_key_here
