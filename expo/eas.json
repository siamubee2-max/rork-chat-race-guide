{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "BUN_CONFIG_FROZEN_LOCKFILE": "0"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "BUN_CONFIG_FROZEN_LOCKFILE": "0"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "BUN_CONFIG_FROZEN_LOCKFILE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "siamubee2@gmail.com",
        "appleTeamId": "SPLML3CN76"
      }
    }
  }
}
